# Variáveis de Ambiente — Franklin Quebra-Galho (A2A v1.0 & FastMCP)
# Copie este arquivo para .env apenas se desejar sobrescrever os padrões locais de desenvolvimento.

# Chave HMAC-SHA256 para assinatura JCS/JWS do AgentCard A2A v1.0 (.well-known/agent-card.json)
FRANKLIN_A2A_SIGNING_SECRET=replace-with-your-local-hmac-sha256-key
FRANKLIN_A2A_KEY_ID=franklin-key-2026-v1
FRANKLIN_A2A_JKU_URL=http://localhost:10999/public_keys.json
FRANKLIN_A2A_HOST_URL=http://localhost:10999
