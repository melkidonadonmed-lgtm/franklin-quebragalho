{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CognitiveAdaptivePlanSchema",
  "description": "Schema canônico v3.0.0 para planos adaptativos não-lineares emitidos pelo high-level-context-planner (intent-cognitive-planner)",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target_orchestrator": {
      "type": "string",
      "enum": ["skill-orquestrador-planos-encadeados"]
    },
    "strategic_goal": {
      "type": "string"
    },
    "intencao": {
      "type": "object",
      "properties": {
        "categoria": {
          "type": "string",
          "enum": ["direta", "estruturada", "ambigua", "mutacao_critica_hitl"]
        },
        "diagnostico": {
          "type": "string"
        },
        "requer_hitl": {
          "type": "boolean"
        }
      },
      "required": ["categoria", "diagnostico", "requer_hitl"],
      "additionalProperties": false
    },
    "frameworks_selecionados": {
      "type": "object",
      "properties": {
        "estrutural": {
          "type": "string",
          "enum": ["CLAREZA", "CREATE", "RTF", "TAG", "TASS"]
        },
        "cognitivo": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CoT", "ReAct", "ToT", "Self-Refine"]
          },
          "minItems": 1
        }
      },
      "required": ["estrutural", "cognitivo"],
      "additionalProperties": false
    },
    "blindagem_complexidade": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SHIELDED", "SUBDIVIDED", "VIOLATION"]
        },
        "max_regras_por_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "disclosure_tier": {
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "estrategia": {
          "type": "string"
        }
      },
      "required": ["status", "max_regras_por_no", "disclosure_tier", "estrategia"],
      "additionalProperties": false
    },
    "grafo_execucao": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "etapa_id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "responsible_skill": {
            "type": "string"
          },
          "tipo_execucao": {
            "type": "string",
            "enum": ["model_reasoning", "tool_io", "decision_gate", "deterministic_code", "hitl_gate"]
          },
          "padrao_cognitivo": {
            "type": "string",
            "enum": ["CoT", "ReAct", "ToT", "Self-Refine"]
          },
          "regras_ativas_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "regras_ativas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          },
          "precondicoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criterio_aceite": {
            "type": "string"
          },
          "ramo_fallback": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "etapa_id",
          "nome",
          "tipo_execucao",
          "padrao_cognitivo",
          "regras_ativas_count",
          "precondicoes",
          "criterio_aceite",
          "ramo_fallback"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "plan_id",
    "version",
    "target_orchestrator",
    "strategic_goal",
    "intencao",
    "frameworks_selecionados",
    "blindagem_complexidade",
    "grafo_execucao"
  ],
  "additionalProperties": false
}
