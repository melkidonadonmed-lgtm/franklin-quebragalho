{
  "franklin-semantic-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/antigravity_harness_hook.py PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/antigravity_harness_hook.py PostToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "franklin-docs-ttl-probe": {
    "enabled": false,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/antigravity_harness_hook.py SessionStart",
        "timeout": 5
      }
    ]
  }
}
